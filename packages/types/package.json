{
  "name": "@tecpap/types",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings 0",
    "clean": "rimraf dist .tsbuildinfo"
  },
  "dependencies": {
    "@tecpap/config": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tecpap/eslint-config": "workspace:*",
    "@tecpap/tsconfig": "workspace:*",
    "eslint": "^9.17.0",
    "rimraf": "^6.0.2",
    "typescript": "^5.5.4"
  }
}
