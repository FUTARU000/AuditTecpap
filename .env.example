# =============================================================
# TECPAP Audit Platform — Environment Variables (template)
# Copy to .env and fill real values. NEVER commit .env.
# =============================================================

# ---------- General ----------
NODE_ENV=development

# ---------- HTTP ports (host side, used by Docker Compose) ----------
WEB_PORT=3000
API_PORT=4000

# Public URLs (used by the browser / SSR)
NEXT_PUBLIC_API_URL=http://localhost:4000
API_URL=http://localhost:4000
APP_URL=http://localhost:3000

# ---------- PostgreSQL ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=tecpap
POSTGRES_PASSWORD=tecpap_password
POSTGRES_DB=tecpap_audit

# Used by Prisma inside the API container
DATABASE_URL=postgresql://tecpap:tecpap_password@postgres:5432/tecpap_audit?schema=public
# Direct connection for migrations
DIRECT_URL=postgresql://tecpap:tecpap_password@postgres:5432/tecpap_audit?schema=public

# ---------- JWT / Auth ----------
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
BCRYPT_SALT_ROUNDS=12

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:3000

# ---------- MinIO (S3-compatible object storage) ----------
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=tecpap_minio
MINIO_SECRET_KEY=tecpap_minio_secret
MINIO_USE_SSL=false
MINIO_BUCKET_EVIDENCE=tecpap-evidence
MINIO_BUCKET_DOCUMENTS=tecpap-documents
MINIO_BUCKET_CERTIFICATES=tecpap-certificates
MINIO_BUCKET_REPORTS=tecpap-reports

# ---------- Google Drive (manual import source — optional) ----------
# Leave both unset to keep Drive import disabled. The service account below
# must be shared (Viewer) on the target Drive folder. No OAuth/user login —
# import is a manual, admin/audit-manager-triggered action only.
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"placeholder@example.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\nPLACEHOLDER\n-----END PRIVATE KEY-----\n"}
GOOGLE_DRIVE_FOLDER_ID=placeholder-drive-folder-id

# ---------- pgAdmin (development only) ----------
PGADMIN_DEFAULT_EMAIL=admin@tecpap.local
PGADMIN_DEFAULT_PASSWORD=tecpap_admin
PGADMIN_PORT=5050
