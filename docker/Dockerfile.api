# syntax=docker/dockerfile:1
# TECPAP Audit — NestJS API image.
FROM node:20-alpine
RUN apk add --no-cache libc6-compat openssl
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

WORKDIR /app

# Don't run git hooks or prune devDeps during the image build.
ENV HUSKY=0

COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @tecpap/api db:generate
RUN pnpm --filter @tecpap/api... build

WORKDIR /app/apps/api
ENV NODE_ENV=production
ENV API_PORT=4000
EXPOSE 4000

CMD ["node", "dist/main.js"]
