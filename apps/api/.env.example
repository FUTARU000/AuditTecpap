# API environment (copy repo-root .env.example for the full set)
NODE_ENV=development
API_PORT=4000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgresql://tecpap:tecpap_password@localhost:5432/tecpap_audit?schema=public
DIRECT_URL=postgresql://tecpap:tecpap_password@localhost:5432/tecpap_audit?schema=public

# JWT / Auth
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
BCRYPT_SALT_ROUNDS=12

# Seed (development)
SEED_ADMIN_EMAIL=admin@tecpap.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=tecpap_minio
MINIO_SECRET_KEY=tecpap_minio_secret
MINIO_USE_SSL=false
