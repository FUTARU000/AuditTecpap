// TECPAP Audit Platform — Prisma schema
// Phase 3: Quality Management Foundation (processes, categories, controlled
// documents, immutable versions, typed relationships, full-text search).
// See SAD §8 for the full target model.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum DepartmentStatus {
  ACTIVE
  INACTIVE
}

enum ProcessStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum DocumentStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  PUBLISHED
  OBSOLETE
  ARCHIVED
}

enum RelationType {
  USES
  GENERATES
  REFERENCES
  REPLACES
  ATTACHMENT
}

enum ConfidentialityLevel {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
}

enum TemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AuditStatus {
  PLANNED
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  RETURNED
  APPROVED
  COMPLETED
}

enum QuestionType {
  YES_NO
  YES_NO_NA
  SHORT_TEXT
  LONG_TEXT
  NUMBER
  DATE
  DROPDOWN
  CHECKBOX
  MULTIPLE_CHOICE
}

enum FindingSeverity {
  OBSERVATION
  OFI
  MINOR_NC
  MAJOR_NC
}

enum IndicatorFrequency {
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
}

/// How a value compares to its thresholds: a rate (HIGHER_IS_BETTER, e.g.
/// compliance %), a defect/cost measure (LOWER_IS_BETTER), or a value that
/// should stay close to an exact target in either direction (TARGET_BASED,
/// where warning/criticalThreshold are the maximum allowed deviation).
enum IndicatorDirection {
  HIGHER_IS_BETTER
  LOWER_IS_BETTER
  TARGET_BASED
}

model User {
  id                     String          @id @default(uuid())
  email                  String          @unique
  passwordHash           String
  firstName              String
  lastName               String
  employeeNumber         String?
  phone                  String?
  avatar                 String?
  status                 UserStatus      @default(ACTIVE)
  lastLoginAt            DateTime?
  failedLoginCount       Int             @default(0)
  lockedUntil            DateTime?
  passwordResetToken     String?
  passwordResetExpiresAt DateTime?

  roleId                 String
  role                   Role            @relation("UserRoles", fields: [roleId], references: [id])

  departmentId           String?
  department             Department?     @relation("DepartmentMembers", fields: [departmentId], references: [id])

  managedDepartments     Department[]    @relation("DepartmentManager")
  refreshTokens          RefreshToken[]
  auditLogs              AuditLog[]      @relation("AuditLogActor")

  // Quality-management back-relations
  ownedProcesses         Process[]       @relation("ProcessOwner")
  ownedDocuments         ControlledDocument[] @relation("DocumentOwner")
  reviewedDocuments      ControlledDocument[] @relation("DocumentReviewer")
  approvedDocuments      ControlledDocument[] @relation("DocumentApprover")
  createdDocuments       ControlledDocument[] @relation("DocumentCreator")
  updatedDocuments       ControlledDocument[] @relation("DocumentUpdater")
  uploadedVersions       DocumentVersion[]    @relation("VersionUploader")
  approvedVersions       DocumentVersion[]    @relation("VersionApprover")

  // Phase 4 — process & operational entities
  businessObjectsOwned   BusinessObject[]     @relation("BusinessObjectOwner")
  businessObjectsCreated BusinessObject[]     @relation("BusinessObjectCreator")
  kpisResponsible        Kpi[]                @relation("KpiResponsible")
  risksOwned             ProcessRisk[]        @relation("RiskOwner")
  processAssignments     ProcessAssignment[]  @relation("ProcessAssignments")
  timelineEvents         ActivityTimeline[]   @relation("TimelineActor")

  // Phase 5 — audit programme
  templatesCreated       AuditTemplate[]      @relation("TemplateCreator")
  templatesUpdated       AuditTemplate[]      @relation("TemplateUpdater")
  auditsAsAuditor        Audit[]              @relation("AuditAuditor")
  auditsAsApprover       Audit[]              @relation("AuditApprover")
  auditsCreated          Audit[]              @relation("AuditCreator")
  findingsResponsible    Finding[]            @relation("FindingResponsible")
  evidenceUploaded       AuditEvidence[]      @relation("EvidenceUploader")
  capasOwned             Capa[]               @relation("CapaOwner")
  capasCreated           Capa[]               @relation("CapaCreator")
  capasClosed            Capa[]               @relation("CapaCloser")
  capaActionsOwned       CapaAction[]         @relation("CapaActionOwner")
  capaEvidenceUploaded   CapaActionEvidence[] @relation("CapaEvidenceUploader")
  capaVerifications      CapaVerification[]   @relation("CapaVerifier")
  capaActionVerifications CapaActionVerification[] @relation("CapaActionVerifier")
  capaEffectivenessReviews CapaEffectivenessReview[] @relation("CapaEffectivenessReviewer")

  // Phase 7 — Legacy QMS import
  importJobsStarted      ImportJob[]          @relation("ImportJobStarter")
  importItemsReviewed    ImportItem[]         @relation("ImportItemReviewer")

  // Phase 7.5 — Workflow, notifications & productivity
  notifications          Notification[]       @relation("UserNotifications")
  favorites              UserFavorite[]       @relation("UserFavorites")
  recentItems            RecentItem[]         @relation("UserRecentItems")
  subscriptions          ReportSubscription[] @relation("UserSubscriptions")
  tasks                  UserTask[]           @relation("UserTasks")

  // Phase 7.6 — Enterprise document experience
  documentComments       DocumentComment[]        @relation("UserDocumentComments")
  resolvedComments       DocumentComment[]        @relation("UserCommentResolver")
  documentAcknowledgements DocumentAcknowledgement[] @relation("UserDocumentAcknowledgements")
  documentCollections    DocumentCollection[]     @relation("UserDocumentCollections")
  documentBookmarks      DocumentBookmark[]       @relation("UserDocumentBookmarks")

  // Indicators — a separate domain from the legacy Kpi model above (kept as-is).
  indicatorsResponsible  Indicator[]              @relation("IndicatorResponsible")
  indicatorsCreated      Indicator[]              @relation("IndicatorCreatedBy")
  indicatorValuesRecorded IndicatorValue[]         @relation("IndicatorValueRecordedBy")

  // Soft delete only — never permanently removed.
  deletedAt              DateTime?

  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  @@index([roleId])
  @@index([departmentId])
  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model Role {
  id          String       @id @default(uuid())
  name        String       @unique
  slug        String       @unique
  description String?
  // System roles cannot be deleted.
  isSystem    Boolean      @default(false)
  // Global roles bypass department data-scoping.
  isGlobal    Boolean      @default(false)
  permissions Permission[]
  users       User[]       @relation("UserRoles")

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  group       String
  label       String?
  description String?
  roles       Role[]

  createdAt   DateTime @default(now())

  @@index([group])
  @@map("permissions")
}

model Department {
  id          String           @id @default(uuid())
  code        String           @unique
  name        String
  description String?
  sortOrder   Int              @default(0)
  status      DepartmentStatus @default(ACTIVE)

  managerId   String?
  manager     User?            @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: SetNull)

  users       User[]           @relation("DepartmentMembers")
  processes   Process[]        @relation("DepartmentProcesses")
  documents   ControlledDocument[] @relation("DepartmentDocuments")
  businessObjects BusinessObject[] @relation("DepartmentBusinessObjects")
  kpis        Kpi[]            @relation("DepartmentKpis")
  auditTemplates AuditTemplate[]
  audits      Audit[]
  capas          Capa[]            @relation("DepartmentCapas")
  indicators  Indicator[]      @relation("DepartmentIndicators")

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status])
  @@map("departments")
}

model RefreshToken {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash      String        @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  replacedById   String?
  replacedBy     RefreshToken? @relation("RefreshTokenReplacement", fields: [replacedById], references: [id])
  replacedByFrom RefreshToken[] @relation("RefreshTokenReplacement")

  createdAt      DateTime      @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Immutable audit log. Append-only by design — the application exposes no
/// update/delete path, and rows reference a nullable actor so logs survive
/// user soft-deletion (SAD §10.3, §17.6).
model AuditLog {
  id         String    @id @default(uuid())
  actorId    String?
  actor      User?     @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  target     String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime  @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// =====================================================================
// Quality Management System
// =====================================================================

model Process {
  id            String        @id @default(uuid())
  code          String
  name          String
  description   String?
  departmentId  String
  department    Department    @relation("DepartmentProcesses", fields: [departmentId], references: [id])
  ownerId       String?
  owner         User?         @relation("ProcessOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  objectives    String?
  scope         String?
  risks         Json?
  opportunities Json?
  kpis          Json?
  status        ProcessStatus @default(ACTIVE)
  revision      Int           @default(1)
  documents     ControlledDocument[]
  businessObjects BusinessObject[]
  kpiRecords    Kpi[]
  processRisks  ProcessRisk[]
  assignments   ProcessAssignment[]
  timeline      ActivityTimeline[]
  auditTemplates AuditTemplate[]
  audits        Audit[]
  findings      Finding[]        @relation("ProcessFindings")
  capas          Capa[]
  deletedAt     DateTime?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([departmentId, code])
  @@index([departmentId])
  @@index([status])
  @@index([deletedAt])
  @@map("processes")
}

model DocumentCategory {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  icon        String?
  color       String?
  description String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  documents   ControlledDocument[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("document_categories")
}

model ControlledDocument {
  id              String              @id @default(uuid())
  title           String
  /// Case-insensitive, whitespace-normalized copy of `title` (see normalizeName in
  /// @tecpap/config) — used to detect duplicate names. Not a unique constraint:
  /// live data already had duplicate titles before this check existed, so
  /// uniqueness is enforced at the service layer instead (same pattern as
  /// IndicatorValue's period uniqueness).
  normalizedTitle String              @default("")
  code            String              @unique
  description     String?
  departmentId    String
  department      Department          @relation("DepartmentDocuments", fields: [departmentId], references: [id])
  processId       String?
  process         Process?            @relation(fields: [processId], references: [id], onDelete: SetNull)
  categoryId      String
  category        DocumentCategory    @relation(fields: [categoryId], references: [id])
  currentVersionId String?
  currentVersion  DocumentVersion?    @relation("DocumentCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  version         String              @default("0.1")
  revision        Int                 @default(0)
  status          DocumentStatus      @default(DRAFT)
  ownerId         String?
  owner           User?               @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  reviewerId      String?
  reviewer        User?               @relation("DocumentReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  approverId      String?
  approver        User?               @relation("DocumentApprover", fields: [approverId], references: [id], onDelete: SetNull)
  keywords        String[]
  confidentiality ConfidentialityLevel @default(INTERNAL)
  effectiveDate   DateTime?
  reviewDate      DateTime?
  expirationDate  DateTime?
  createdById     String
  createdBy       User                @relation("DocumentCreator", fields: [createdById], references: [id])
  updatedById     String?
  updatedBy       User?               @relation("DocumentUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  versions        DocumentVersion[]
  relationsAsSource DocumentRelation[] @relation("RelationSource")
  relationsAsTarget DocumentRelation[] @relation("RelationTarget")

  // Phase 7.6 — Enterprise document experience
  comments            DocumentComment[]        @relation("DocumentComments")
  acknowledgements    DocumentAcknowledgement[] @relation("DocumentAcknowledgements")
  collectionItems     DocumentCollectionItem[] @relation("DocumentCollectionLinks")

  /// PostgreSQL full-text search vector — generated + indexed via a raw migration.
  searchVector   Unsupported("tsvector")?

  deletedAt      DateTime?

  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([departmentId])
  @@index([processId])
  @@index([categoryId])
  @@index([status])
  @@index([ownerId])
  @@index([deletedAt])
  @@index([expirationDate])
  @@index([normalizedTitle])
  @@map("controlled_documents")
}

/// Immutable document version. Once written it is never updated or deleted by
/// the application — only a new version can supersede it.
model DocumentVersion {
  id           String   @id @default(uuid())
  documentId   String
  document     ControlledDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version      String
  revision     Int
  fileKey      String
  fileName     String
  mimeType     String
  sizeBytes    Int
  checksum     String?
  comment      String?
  uploadedById String
  uploadedBy   User     @relation("VersionUploader", fields: [uploadedById], references: [id])
  approvedById String?
  approvedBy   User?    @relation("VersionApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?
  currentFor   ControlledDocument[] @relation("DocumentCurrentVersion")

  createdAt    DateTime @default(now())

  @@index([documentId])
  @@index([uploadedById])
  @@map("document_versions")
}

/// Typed many-to-many relationship between controlled documents.
model DocumentRelation {
  id               String       @id @default(uuid())
  sourceDocumentId String
  sourceDocument   ControlledDocument @relation("RelationSource", fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  targetDocumentId String
  targetDocument   ControlledDocument @relation("RelationTarget", fields: [targetDocumentId], references: [id], onDelete: Cascade)
  type             RelationType
  createdAt        DateTime     @default(now())

  @@unique([sourceDocumentId, targetDocumentId, type])
  @@index([sourceDocumentId])
  @@index([targetDocumentId])
  @@map("document_relations")
}

// =====================================================================
// Phase 4 — Business Process & Operational Management
// =====================================================================

/// Configurable catalog of business-object kinds (Production Orders, Suppliers,
/// Machines, Employees, …). Administrators add more; never hardcoded.
model BusinessObjectType {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  icon        String?
  color       String?
  description String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  objects     BusinessObject[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("business_object_types")
}

/// A concrete operational entity owned by a process (e.g. a specific machine,
/// supplier, or production order). `attributes` holds type-specific fields.
model BusinessObject {
  id           String   @id @default(uuid())
  typeId       String
  type         BusinessObjectType @relation(fields: [typeId], references: [id])
  departmentId String
  department   Department @relation("DepartmentBusinessObjects", fields: [departmentId], references: [id])
  processId    String?
  process      Process? @relation(fields: [processId], references: [id], onDelete: SetNull)
  name         String
  code         String
  status       String   @default("ACTIVE")
  attributes   Json?
  ownerId      String?
  owner        User?    @relation("BusinessObjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdById  String
  createdBy    User     @relation("BusinessObjectCreator", fields: [createdById], references: [id])
  deletedAt    DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([departmentId, code])
  @@index([typeId])
  @@index([processId])
  @@index([departmentId])
  @@index([status])
  @@map("business_objects")
}

/// Configurable KPI. Current value/trend are set manually today; future data
/// sources (ERP, IoT) can populate them via the same record — no redesign.
model Kpi {
  id                String   @id @default(uuid())
  name              String
  description       String?
  formula           String?
  unit              String?
  target            Float?
  warningThreshold  Float?
  criticalThreshold Float?
  currentValue      Float?
  trend             String? // UP | DOWN | STABLE
  frequency         String   @default("MONTHLY")
  status            String   @default("ACTIVE")
  responsibleUserId String?
  responsible       User?    @relation("KpiResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  departmentId      String?
  department        Department? @relation("DepartmentKpis", fields: [departmentId], references: [id], onDelete: SetNull)
  processId         String?
  process           Process? @relation(fields: [processId], references: [id], onDelete: SetNull)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([processId])
  @@index([departmentId])
  @@index([status])
  @@map("kpis")
}

// =====================================================================
// Indicators — TECPAP quality indicators. A separate domain from the
// legacy Kpi model above, which is left untouched for its existing callers
// (ReminderService, WorkspaceService). One definition + many historical
// values; updating the definition never touches recorded values.
// =====================================================================

model Indicator {
  id                String             @id @default(uuid())
  code              String             @unique
  name              String
  description       String?
  departmentId      String
  department        Department         @relation("DepartmentIndicators", fields: [departmentId], references: [id])
  category          String?
  unit              String?
  direction         IndicatorDirection @default(HIGHER_IS_BETTER)
  target            Float?
  warningThreshold  Float?
  criticalThreshold Float?
  frequency         IndicatorFrequency @default(MONTHLY)
  responsibleUserId String?
  responsible       User?              @relation("IndicatorResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  active            Boolean            @default(true)
  createdById       String
  createdBy         User               @relation("IndicatorCreatedBy", fields: [createdById], references: [id])

  values            IndicatorValue[]

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([departmentId])
  @@index([active])
  @@index([category])
  @@map("indicators")
}

/// One historical measurement. Never mutated by an Indicator update — this is
/// the append-only audit trail of recorded values.
///
/// `year`/`periodMonth` are the deterministic period key the grid UI reads:
/// periodMonth is always a calendar month (1-12), snapped to the frequency's
/// representative month (e.g. QUARTERLY's Q3 is always periodMonth=9). There
/// is deliberately no unique constraint on (indicatorId, year, periodMonth):
/// recordValue() upserts by that key at the service layer instead, so a
/// correction updates the existing period's row rather than stacking a
/// duplicate — chosen because live historical data already predates this
/// column pair and a DB-level constraint would reject it on migration.
model IndicatorValue {
  id           String    @id @default(uuid())
  indicatorId  String
  indicator    Indicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)
  value        Float
  year         Int
  periodMonth  Int
  measuredAt   DateTime
  comment      String?
  recordedById String?
  recordedBy   User?     @relation("IndicatorValueRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([indicatorId, measuredAt])
  @@index([indicatorId, year, periodMonth])
  @@map("indicator_values")
}

/// A risk owned by a process. riskScore = probability × impact (1–5 each).
model ProcessRisk {
  id           String   @id @default(uuid())
  processId    String
  process      Process  @relation(fields: [processId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  probability  Int      @default(3)
  impact       Int      @default(3)
  riskScore    Int      @default(9)
  ownerId      String?
  owner        User?    @relation("RiskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  mitigation   String?
  reviewDate   DateTime?
  status       String   @default("OPEN")

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([processId])
  @@index([status])
  @@map("process_risks")
}

/// Process responsibilities — Owner / Approver / Operator / Auditor / Manager.
/// A future workflow engine resolves assignees from these.
model ProcessAssignment {
  id        String   @id @default(uuid())
  processId String
  process   Process  @relation(fields: [processId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("ProcessAssignments", fields: [userId], references: [id], onDelete: Cascade)
  role      String   // OWNER | APPROVER | OPERATOR | AUDITOR | MANAGER

  createdAt DateTime @default(now())

  @@unique([processId, userId, role])
  @@index([processId])
  @@index([userId])
  @@map("process_assignments")
}

/// Process-scoped activity feed (document updates, risk/KPI changes, …).
model ActivityTimeline {
  id         String   @id @default(uuid())
  processId  String?
  process    Process? @relation(fields: [processId], references: [id], onDelete: SetNull)
  eventType  String
  title      String
  entityType String
  entityId   String?
  actorId    String?
  actor      User?    @relation("TimelineActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([processId, createdAt])
  @@index([entityType, entityId])
  @@map("activity_timeline")
}

/// Generic relationship engine — any entity to any entity (document ↔ risk ↔
/// audit ↔ finding; supplier → order → inspection → production → customer).
/// Polymorphic by (entityType, entityId), so it needs no per-entity FKs.
model BusinessRelationship {
  id         String   @id @default(uuid())
  sourceType String
  sourceId   String
  targetType String
  targetId   String
  type       String   // USES | GENERATES | REFERENCES | REPLACES | ATTACHMENT
  label      String?

  createdAt  DateTime @default(now())

  @@unique([sourceType, sourceId, targetType, targetId, type])
  @@index([sourceType, sourceId])
  @@index([targetType, targetId])
  @@map("business_relationships")
}

// =====================================================================
// Phase 5 — Audit Management & Digital Checklist Engine
// =====================================================================

model AuditTemplate {
  id          String         @id @default(uuid())
  name        String
  /// See ControlledDocument.normalizedTitle — same pattern, service-layer enforced.
  normalizedName String      @default("")
  description String?
  category    String
  version     Int            @default(1)
  status      TemplateStatus @default(DRAFT)
  departmentId String?
  department  Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  processId   String?
  process     Process?       @relation(fields: [processId], references: [id], onDelete: SetNull)
  createdById String
  createdBy   User           @relation("TemplateCreator", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?          @relation("TemplateUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  sections    AuditTemplateSection[]
  audits      Audit[]

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status])
  @@index([departmentId])
  @@index([processId])
  @@index([normalizedName])
  @@map("audit_templates")
}

model AuditTemplateSection {
  id          String   @id @default(uuid())
  templateId  String
  template    AuditTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  title       String
  order       Int      @default(0)
  description String?

  questions   AuditTemplateQuestion[]

  @@index([templateId])
  @@map("audit_template_sections")
}

model AuditTemplateQuestion {
  id              String       @id @default(uuid())
  sectionId       String
  section         AuditTemplateSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  text            String
  type            QuestionType
  required        Boolean      @default(false)
  weight          Float        @default(1)
  order           Int          @default(0)
  description     String?
  helpText        String?
  defaultAnswer   Json?
  evidenceRequired Boolean     @default(false)
  findingRequired Boolean      @default(false)
  options         String[]     @default([])

  answers         AuditAnswer[]

  @@index([sectionId])
  @@map("audit_template_questions")
}

model Audit {
  id           String      @id @default(uuid())
  title        String
  /// See ControlledDocument.normalizedTitle — same pattern, service-layer enforced.
  normalizedTitle String   @default("")
  templateId   String
  template     AuditTemplate @relation(fields: [templateId], references: [id])
  departmentId String
  department   Department  @relation(fields: [departmentId], references: [id])
  processId    String?
  process      Process?    @relation(fields: [processId], references: [id], onDelete: SetNull)
  auditorId    String?
  auditor      User?       @relation("AuditAuditor", fields: [auditorId], references: [id], onDelete: SetNull)
  status       AuditStatus @default(PLANNED)
  scheduledDate DateTime?
  startedAt    DateTime?
  submittedAt  DateTime?
  approvedAt   DateTime?
  approvedById String?
  approvedBy   User?       @relation("AuditApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  reviewComment String?
  score        Float?
  compliance   Float?
  createdById  String
  createdBy    User        @relation("AuditCreator", fields: [createdById], references: [id])

  answers      AuditAnswer[]
  findings     Finding[]
  evidence     AuditEvidence[]

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([templateId])
  @@index([departmentId])
  @@index([processId])
  @@index([status])
  @@index([auditorId])
  @@index([normalizedTitle])
  @@map("audits")
}

model AuditAnswer {
  id         String   @id @default(uuid())
  auditId    String
  audit      Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)
  questionId String
  question   AuditTemplateQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  value      Json?
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([auditId, questionId])
  @@index([auditId])
  @@map("audit_answers")
}

model Finding {
  id               String          @id @default(uuid())
  auditId          String
  audit            Audit           @relation(fields: [auditId], references: [id], onDelete: Cascade)
  questionId       String?
  title            String
  description      String?
  severity         FindingSeverity
  responsibleUserId String?
  responsible      User?           @relation("FindingResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  dueDate          DateTime?
  status           String          @default("OPEN")
  processId        String?
  process          Process?        @relation("ProcessFindings", fields: [processId], references: [id], onDelete: SetNull)
  comments         String?
  capaDecision     String?
  capaDecisionById String?
  capaDecisionDate DateTime?
  capaDecisionReason String?
  capas            Capa[]           @relation("FindingCapas")

  evidence         AuditEvidence[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([auditId])
  @@index([severity])
  @@index([status])
  @@map("findings")
}

model AuditEvidence {
  id           String   @id @default(uuid())
  auditId      String?
  audit        Audit?   @relation(fields: [auditId], references: [id], onDelete: Cascade)
  questionId   String?
  findingId    String?
  finding      Finding? @relation(fields: [findingId], references: [id], onDelete: SetNull)
  fileKey      String
  fileName     String
  mimeType     String
  sizeBytes    Int
  comment      String?
  uploadedById String
  uploadedBy   User     @relation("EvidenceUploader", fields: [uploadedById], references: [id])

  createdAt    DateTime @default(now())

  @@index([auditId])
  @@index([findingId])
  @@map("audit_evidence")
}

// =====================================================================
// Phase 6 — CAPA & Continuous Improvement
// =====================================================================

enum CapaStatus {
  DRAFT
  ROOT_CAUSE_ANALYSIS
  ACTION_PLAN
  IN_PROGRESS
  PENDING_VERIFICATION
  PENDING_EFFECTIVENESS
  CLOSED
  CANCELLED
  /// Phase 7.7 — TECPAP workflow
  ASSIGNED
  EVIDENCE_UPLOADED
  RETURNED
  VALIDATED
}

enum CapaPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CapaActionType {
  CONTAINMENT
  CORRECTIVE
  PREVENTIVE
}

enum CapaActionStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  VERIFIED
  CANCELLED
}

enum VerificationResult {
  PASSED
  FAILED
}

enum EffectivenessResult {
  EFFECTIVE
  PARTIALLY_EFFECTIVE
  INEFFECTIVE
}

model Capa {
  id                   String       @id @default(uuid())
  referenceNumber      String       @unique
  title                String
  /// See ControlledDocument.normalizedTitle — same pattern, service-layer enforced.
  normalizedTitle      String       @default("")
  description          String?
  sourceType           String       @default("MANUAL")
  sourceId             String?
  findingId            String?
  finding              Finding?     @relation("FindingCapas", fields: [findingId], references: [id], onDelete: SetNull)
  departmentId         String
  department           Department   @relation("DepartmentCapas", fields: [departmentId], references: [id])
  processId            String?
  process              Process?     @relation(fields: [processId], references: [id], onDelete: SetNull)
  ownerId              String?
  owner                User?        @relation("CapaOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdById          String
  createdBy            User         @relation("CapaCreator", fields: [createdById], references: [id])
  priority             CapaPriority @default(MEDIUM)
  status               CapaStatus   @default(DRAFT)
  targetDate           DateTime?
  openedAt             DateTime?
  submittedAt          DateTime?
  verifiedAt           DateTime?
  effectivenessDueDate DateTime?
  effectivenessReviewedAt DateTime?
  closedAt             DateTime?
  closedById           String?
  closedBy             User?        @relation("CapaCloser", fields: [closedById], references: [id], onDelete: SetNull)
  closureComment       String?

  rootCause            CapaRootCauseAnalysis?
  actions              CapaAction[]
  /// Phase 3 — every verification attempt is preserved (1:N); never overwritten.
  verifications        CapaVerification[]
  effectiveness        CapaEffectivenessReview?

  deletedAt            DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([departmentId])
  @@index([status])
  @@index([findingId])
  @@index([ownerId])
  @@index([processId])
  @@index([normalizedTitle])
  @@map("capas")
}

model CapaRootCauseAnalysis {
  id                  String   @id @default(uuid())
  capaId              String   @unique
  capa                Capa     @relation(fields: [capaId], references: [id], onDelete: Cascade)
  problemStatement    String?
  immediateCause      String?
  rootCause           String?
  contributingFactors String?
  analysisNotes       String?
  useFiveWhys         Boolean  @default(false)
  useEightD           Boolean  @default(false)

  whySteps            CapaWhyStep[]
  eightD              CapaEightD?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("capa_root_cause_analyses")
}

model CapaWhyStep {
  id         String   @id @default(uuid())
  analysisId String
  analysis   CapaRootCauseAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  stepNumber Int
  question   String
  answer     String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([analysisId])
  @@map("capa_why_steps")
}

model CapaEightD {
  id                   String   @id @default(uuid())
  analysisId           String   @unique
  analysis             CapaRootCauseAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  d1Team               String?
  d2ProblemDescription String?
  d3InterimActions     String?
  d4RootCause          String?
  d5PermanentActions   String?
  d6Implementation     String?
  d7Prevention         String?
  d8Closure            String?

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("capa_eight_ds")
}

model CapaAction {
  id                String         @id @default(uuid())
  capaId            String
  capa              Capa           @relation(fields: [capaId], references: [id], onDelete: Cascade)
  title             String
  description       String?
  actionType        CapaActionType @default(CORRECTIVE)
  ownerId           String?
  owner             User?          @relation("CapaActionOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  priority          CapaPriority   @default(MEDIUM)
  status            CapaActionStatus @default(OPEN)
  dueDate           DateTime?
  completedAt       DateTime?
  completionComment String?

  evidence          CapaActionEvidence[]
  verifications     CapaActionVerification[]

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([capaId])
  @@index([ownerId])
  @@map("capa_actions")
}

model CapaActionEvidence {
  id           String   @id @default(uuid())
  actionId     String
  action       CapaAction @relation(fields: [actionId], references: [id], onDelete: Cascade)
  fileKey      String
  fileName     String
  mimeType     String
  sizeBytes    Int
  comment      String?
  uploadedById String
  uploadedBy   User     @relation("CapaEvidenceUploader", fields: [uploadedById], references: [id])

  createdAt    DateTime @default(now())

  @@index([actionId])
  @@map("capa_action_evidence")
}

/// Phase 3 — immutable audit trail: one row per verification attempt, never
/// updated or upserted. A CAPA that fails, is reworked, and is resubmitted
/// accumulates one CapaVerification row per attempt (schema.prisma §21.4).
model CapaVerification {
  id           String             @id @default(uuid())
  capaId       String
  capa         Capa               @relation(fields: [capaId], references: [id], onDelete: Cascade)
  verifiedById String
  verifiedBy   User               @relation("CapaVerifier", fields: [verifiedById], references: [id])
  result       VerificationResult
  notes        String?
  verifiedAt   DateTime           @default(now())

  @@index([capaId, verifiedAt])
  @@map("capa_verifications")
}

/// Individual per-action verification — a separate history from CapaVerification
/// (which judges the CAPA as a whole). Same immutable-attempt shape: one row per
/// attempt, never updated, so a FAILED → reworked → PASSED cycle keeps both
/// attempts visible. Reuses VerificationResult (PASSED|FAILED) rather than a new enum.
model CapaActionVerification {
  id           String             @id @default(uuid())
  actionId     String
  action       CapaAction         @relation(fields: [actionId], references: [id], onDelete: Cascade)
  verifiedById String
  verifiedBy   User               @relation("CapaActionVerifier", fields: [verifiedById], references: [id])
  result       VerificationResult
  notes        String?
  verifiedAt   DateTime           @default(now())

  @@index([actionId, verifiedAt])
  @@map("capa_action_verifications")
}

model CapaEffectivenessReview {
  id            String               @id @default(uuid())
  capaId        String               @unique
  capa          Capa                 @relation(fields: [capaId], references: [id], onDelete: Cascade)
  reviewedById  String
  reviewedBy    User                 @relation("CapaEffectivenessReviewer", fields: [reviewedById], references: [id])
  result        EffectivenessResult
  notes         String?
  reviewedAt    DateTime             @default(now())

  @@map("capa_effectiveness_reviews")
}

// =====================================================================
// Phase 7 — Legacy QMS Import & Enterprise Knowledge Digitalization
// =====================================================================
// Every import is an ImportJob made of ImportItems. Each item permanently
// stores its original Drive traceability (path, filename, checksum, importer)
// and, once reviewed, materializes into an existing QMS entity (controlled
// document, audit template, business object) — never a duplicate store.

enum ImportSource {
  LOCAL
  GOOGLE_DRIVE
  UPLOAD
}

enum ImportJobStatus {
  PENDING
  SCANNING
  PARSING
  CLASSIFYING
  WAITING_REVIEW
  IMPORTING
  COMPLETED
  FAILED
  CANCELLED
}

enum ImportItemType {
  CONTROLLED_DOCUMENT
  AUDIT_TEMPLATE
  BUSINESS_OBJECT
}

enum ImportItemStatus {
  PENDING
  PARSED
  CLASSIFIED
  DUPLICATE
  AWAITING_REVIEW
  APPROVED
  REJECTED
  IMPORTED
  FAILED
  SKIPPED
}

enum ReviewDecision {
  APPROVE
  REJECT
  MERGE
  REPLACE_VERSION
}

model ImportJob {
  id             String          @id @default(uuid())
  source         ImportSource    @default(UPLOAD)
  sourceLocation String?
  name           String?
  status         ImportJobStatus @default(PENDING)
  startedById    String
  startedBy      User            @relation("ImportJobStarter", fields: [startedById], references: [id])
  progress       Int             @default(0)
  processed      Int             @default(0)
  imported       Int             @default(0)
  skipped        Int             @default(0)
  failed         Int             @default(0)
  duplicates     Int             @default(0)
  warnings       Int             @default(0)
  errorMessage   String?
  /// Aggregate roll-up (byDepartment, byCategory, byFormat, timings…).
  stats          Json?
  /// Array of { fileName, message } for surface-level error reporting.
  errors         Json?
  cancelledAt    DateTime?
  completedAt    DateTime?

  items          ImportItem[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([startedById])
  @@index([status])
  @@map("import_jobs")
}

model ImportItem {
  id            String           @id @default(uuid())
  jobId         String
  job           ImportJob        @relation(fields: [jobId], references: [id], onDelete: Cascade)

  // ---- Permanent source traceability (never overwritten, never deleted) ----
  originalPath  String
  relativePath  String?
  fileName      String
  extension     String
  mimeType      String?
  sizeBytes     Int
  checksum      String?
  parentFolder  String?
  format        String

  // ---- Parsing ----
  status        ImportItemStatus @default(PENDING)
  parsedMetadata Json?
  /// Extracted text (full for indexing/preview; truncated only for transport).
  contentText   String?
  pageCount     Int?
  tableCount    Int?
  imageCount    Int?
  ocrNeeded     Boolean          @default(false)
  ocrText       String?
  warnings      Json?
  error         String?

  // ---- Classification ----
  detectedType  String?
  targetEntityType ImportItemType?
  classification Json?

  // ---- Duplicate / version detection ----
  duplicateOfId String?
  duplicateStrategy String?

  // ---- Review ----
  reviewDecision ReviewDecision?
  reviewNote    String?
  reviewById    String?
  reviewBy      User?            @relation("ImportItemReviewer", fields: [reviewById], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?

  // ---- Materialization ----
  fileKey           String?
  importedEntityId  String?
  importedEntityType String?
  importedAt        DateTime?

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([jobId])
  @@index([status])
  @@index([checksum])
  @@index([importedEntityId])
  @@map("import_items")
}

// =====================================================================
// Phase 7.5 — Workflow, Notifications & Productivity
// =====================================================================

enum NotificationSeverity {
  INFO
  SUCCESS
  WARNING
  CRITICAL
}

model Notification {
  id          String               @id @default(uuid())
  userId      String
  user        User                 @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  type        String               // AUDIT_ASSIGNED | CAPA_OVERDUE | DOCUMENT_AWAITING_APPROVAL | ...
  category    String               // audit | capa | document | risk | kpi | import | system
  severity    NotificationSeverity @default(INFO)
  /// English fallback text — always populated (legacy rows and the email body
  /// both rely on it). When `params` is set, the frontend prefers rendering a
  /// localized version from `type` + `params` via the shared notification
  /// template catalog (packages/config) instead of this literal text.
  title       String
  message     String
  /// Phase 5 — structured interpolation params for centralized EN/FR
  /// notification templates. Null on notifications created before Phase 5
  /// (and on any type with no template, e.g. free-text comment mentions) —
  /// those always render from the stored `title`/`message` above.
  params      Json?
  entityType  String?
  entityId    String?
  actionUrl   String?
  departmentId String?
  readAt      DateTime?
  archivedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime             @default(now())

  @@index([userId, readAt])
  @@index([userId, archivedAt])
  @@index([type, entityId, userId])
  @@map("notifications")
}

model UserFavorite {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation("UserFavorites", fields: [userId], references: [id], onDelete: Cascade)
  entityType String
  entityId   String
  label      String
  href       String
  icon       String?
  createdAt  DateTime @default(now())

  @@unique([userId, entityType, entityId])
  @@map("user_favorites")
}

model RecentItem {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation("UserRecentItems", fields: [userId], references: [id], onDelete: Cascade)
  entityType String
  entityId   String
  label      String
  href       String
  viewedAt   DateTime @default(now())

  @@unique([userId, entityType, entityId])
  @@index([userId, viewedAt])
  @@map("recent_items")
}

model ReportSubscription {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation("UserSubscriptions", fields: [userId], references: [id], onDelete: Cascade)
  reportType String   // weekly_kpi | monthly_capa | audit_completion | department_dashboard
  frequency  String   // DAILY | WEEKLY | MONTHLY
  channel    String   @default("email")
  params     Json?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, reportType])
  @@map("report_subscriptions")
}

/// Personal task center — auto-generated from assignments/approvals, with
/// completion/dismissal overrides. Snapshotted so it can be marked complete.
model UserTask {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation("UserTasks", fields: [userId], references: [id], onDelete: Cascade)
  source      String    // audit | capa | document | import | finding | risk
  entityType  String
  entityId    String
  title       String
  priority    String    @default("MEDIUM")
  dueDate     DateTime?
  href        String?
  completedAt DateTime?
  dismissedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, entityType, entityId])
  @@index([userId, completedAt])
  @@map("user_tasks")
}

// =====================================================================
// Phase 7.6 — Enterprise Document Experience
// =====================================================================
// Comments, read acknowledgements, collections (links only — no file
// duplication), and bookmarks. Insights + history reuse the existing
// ActivityTimeline; preview/compare/export reuse the import parsers + storage.

model DocumentComment {
  id            String   @id @default(uuid())
  documentId    String
  document      ControlledDocument @relation("DocumentComments", fields: [documentId], references: [id], onDelete: Cascade)
  versionId     String?
  parentId      String?
  parent        DocumentComment?   @relation("CommentReplies", fields: [parentId], references: [id], onDelete: NoAction)
  replies       DocumentComment[]  @relation("CommentReplies")
  authorId      String
  author        User     @relation("UserDocumentComments", fields: [authorId], references: [id])
  body          String
  mentions      String[] @default([])
  resolved      Boolean  @default(false)
  resolvedById  String?
  resolvedBy    User?    @relation("UserCommentResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt    DateTime?
  editedAt      DateTime?
  /// Edit history — array of prior bodies + timestamp.
  previousBodies Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([documentId])
  @@index([parentId])
  @@map("document_comments")
}

model DocumentAcknowledgement {
  id             String   @id @default(uuid())
  documentId     String
  document       ControlledDocument @relation("DocumentAcknowledgements", fields: [documentId], references: [id], onDelete: Cascade)
  versionId      String
  userId         String
  user           User     @relation("UserDocumentAcknowledgements", fields: [userId], references: [id], onDelete: Cascade)
  departmentId   String?
  acknowledgedAt DateTime @default(now())
  createdAt      DateTime @default(now())

  @@unique([documentId, versionId, userId])
  @@index([documentId])
  @@map("document_acknowledgements")
}

model DocumentCollection {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation("UserDocumentCollections", fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       DocumentCollectionItem[]

  @@map("document_collections")
}

/// A link from a collection to a document — no bytes are duplicated.
model DocumentCollectionItem {
  id           String   @id @default(uuid())
  collectionId String
  collection   DocumentCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  documentId   String
  document     ControlledDocument @relation("DocumentCollectionLinks", fields: [documentId], references: [id], onDelete: Cascade)
  addedAt      DateTime @default(now())

  @@unique([collectionId, documentId])
  @@map("document_collection_items")
}

model DocumentBookmark {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("UserDocumentBookmarks", fields: [userId], references: [id], onDelete: Cascade)
  type      String   // document | version | search | collection
  entityId  String
  versionId String?
  label     String
  href      String
  createdAt DateTime @default(now())

  @@unique([userId, type, entityId])
  @@index([userId])
  @@map("document_bookmarks")
}
